PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/chatgpt_clone
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=refreshToken
NODE_ENV=development
MISTRAL_API_KEY=replace_with_mistral_api_key
TAVILY_API_KEY=replace_with_tavily_api_key

# LangSmith agent tracing
LANGSMITH_API_KEY=replace_with_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=Gpt
LANGCHAIN_CALLBACKS_BACKGROUND=true
